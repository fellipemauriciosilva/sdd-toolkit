{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdd-toolkit.dev/schemas/delivery-contract.schema.json",
  "title": "SDD delivery and verification contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "delivery_kind", "verification", "rationale", "owner", "expected_evidence"],
  "properties": {
    "schema_version": {"const": 1},
    "delivery_kind": {"enum": ["application", "refactor", "unit-tests", "integration-tests", "e2e-tests", "migration"]},
    "verification": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["none", "unit", "integration", "e2e"]}
    },
    "rationale": {"type": "string", "minLength": 1, "maxLength": 2000},
    "owner": {"const": "sdd-analyze-demand"},
    "expected_evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "commands": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "contract_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"}
  },
  "allOf": [
    {"if": {"properties": {"delivery_kind": {"const": "e2e-tests"}}}, "then": {"properties": {"verification": {"contains": {"const": "e2e"}}}}},
    {"if": {"properties": {"verification": {"contains": {"const": "none"}}}}, "then": {"properties": {"verification": {"maxItems": 1}}}}
  ]
}
