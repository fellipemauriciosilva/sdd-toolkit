{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdd-toolkit.dev/schemas/sdd-profile.schema.json",
  "title": "SDD Toolkit profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scope", "name", "runtimes", "toolkit_version"],
  "properties": {
    "schema_version": {"const": 1},
    "scope": {"enum": ["user", "organization"]},
    "name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "runtimes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["copilot", "claude", "codex", "cursor"]}
    },
    "toolkit_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"},
    "description": {"type": "string", "maxLength": 500}
  }
}
