{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdd-toolkit.dev/schemas/architecture-contract.schema.json",
  "title": "SDD architectural design contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "architecture_impact", "architecture_status", "architecture_agent", "architecture_mode", "architecture_artifact", "rationale", "required_evidence"],
  "properties": {
    "schema_version": {"const": 1},
    "contract_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
    "architecture_impact": {"enum": ["low", "medium", "high"]},
    "architecture_status": {"enum": ["pending", "analyzing", "designed", "blocked", "approved", "superseded"]},
    "architecture_agent": {"const": "sdd-architect"},
    "architecture_mode": {"enum": ["design", "review-task"]},
    "architecture_artifact": {"type": "string", "pattern": "^(?!/)(?![A-Za-z]:)[^\\x00-\\x1f]+$"},
    "rationale": {"type": "string", "minLength": 1, "maxLength": 2000},
    "decisions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "required_evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "full_design_required": {"type": "boolean"}
  }
}
