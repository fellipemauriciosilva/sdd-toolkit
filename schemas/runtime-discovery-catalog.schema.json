{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdd-toolkit.dev/schemas/runtime-discovery-catalog.schema.json",
  "title": "SDD Toolkit runtime discovery catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sources", "runtimes"],
  "properties": {
    "schema_version": {"const": 1},
    "sources": {"type": "array", "minItems": 1, "items": {"type": "string", "format": "uri"}, "uniqueItems": true},
    "runtimes": {
      "type": "object",
      "propertyNames": {"enum": ["claude", "codex", "copilot", "cursor"]},
      "required": ["claude", "codex", "copilot", "cursor"],
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["extension_ids", "packages", "desktop_names"],
        "properties": {
          "extension_ids": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9-]+\\.[a-z0-9-]+$"}, "uniqueItems": true},
          "packages": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}},
          "desktop_names": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
        }
      }
    }
  }
}
