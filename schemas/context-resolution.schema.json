{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdd-toolkit.dev/schemas/context-resolution.schema.json",
  "title": "SDD Toolkit resolved execution context",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "scope", "source", "profile", "runtime", "project", "workspace", "activation_state", "writes_project"],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"enum": ["ready", "unactivated"]},
    "scope": {"const": "user"},
    "source": {"enum": ["user-activation", "default"]},
    "profile": {"type": "string", "minLength": 1},
    "runtime": {"enum": ["copilot", "claude", "codex", "cursor", "all"]},
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "path", "project_id"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "project_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "workspace": {"type": "string", "minLength": 1},
    "activation_state": {"type": "string", "minLength": 1},
    "writes_project": {"const": false},
    "ticket": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "spec_path": {"type": "string", "minLength": 1}
  }
}
