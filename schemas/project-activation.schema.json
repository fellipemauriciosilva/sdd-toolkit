{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdd-toolkit.dev/schemas/project-activation.schema.json",
  "title": "SDD Toolkit project activation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scope",
    "profile",
    "runtime",
    "project_id",
    "project_name",
    "project_path",
    "workspace_root",
    "workspace",
    "kit_root",
    "toolkit_version",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "scope": {"const": "user"},
    "profile": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "runtime": {"enum": ["copilot", "claude", "codex", "cursor", "all"]},
    "project_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "project_name": {"type": "string", "minLength": 1, "maxLength": 255},
    "project_path": {"type": "string", "minLength": 1},
    "workspace_root": {"type": "string", "minLength": 1},
    "workspace": {"type": "string", "minLength": 1},
    "kit_root": {"type": "string", "minLength": 1},
    "toolkit_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  }
}
