{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdd-toolkit.dev/schemas/runtime-capabilities.schema.json",
  "title": "Versioned runtime capability declarations",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "runtimes"],
  "properties": {
    "schema_version": {"const": 1},
    "runtimes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rules"],
        "properties": {
          "rules": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["min_version", "capabilities", "evidence"],
              "properties": {
                "min_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
                "capabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
                "evidence": {"enum": ["declared-baseline", "verified-fixture", "verified-harness"]}
              }
            }
          }
        }
      }
    }
  }
}
